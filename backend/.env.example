# --- Fireflies clone backend config (see docs/04-TECH-STACK-AND-LIBRARIES.md §5) ---

# SQLite database file (relative to backend/)
# FIREFLIES_DB_PATH=data/fireflies.db

# Generated + uploaded media directory
# MEDIA_DIR=data/media

# Auto-seed the database on startup when empty (keeps hosted demo alive)
# SEED_ON_START=true

# Comma-separated allowed origins for the frontend
# CORS_ORIGINS=http://localhost:3000

# Groq meeting summaries/chat. Keep external calls disabled
# until you explicitly consent to sending selected meeting content to Groq.
# Never put these secrets in frontend/.env or NEXT_PUBLIC_* variables.
# LLM_ALLOW_EXTERNAL=false
# LLM_API_KEY=
# LLM_BASE_URL=https://api.groq.com/openai/v1
# Select a supported Groq model; no model is silently chosen for you.
# LLM_MODEL=openai/gpt-oss-20b
# JSON object mode works with broader model support. json_schema uses strict
# structured output and requires a Groq model supporting it.
# LLM_RESPONSE_FORMAT=json_schema  # verified with openai/gpt-oss-20b
# LLM_TIMEOUT_SECONDS=15
# LLM_TOTAL_TIMEOUT_SECONDS=30
# LLM_MAX_RETRIES=1
# LLM_MAX_INPUT_CHARS=48000
# LLM_MAX_OUTPUT_TOKENS=4096
# LLM_MAX_RESPONSE_BYTES=200000
# LLM_MAX_CONCURRENT=2
# LLM_REQUESTS_PER_MINUTE=20
# LLM_REQUESTS_PER_DAY=200
# LLM_TOKENS_PER_DAY=1000000
# AI_REQUESTS_PER_IP_MINUTE=30

# Hybrid retrieval: lexical indexing is safe/lightweight by default.
# RAG_INDEXING_ENABLED=true
# RAG_INFERENCE_MODE=disabled  # disabled | local | remote
# RAG_CHUNK_CHARS=800          # approximate budget; local tokenizer also checks
# RAG_OVERLAP_TURNS=1
# RAG_BATCH_SIZE=8
# RAG_POLL_SECONDS=5
# RAG_RETRY_SECONDS=60
# RAG_MAX_INDEX_SECONDS=60     # checked between batches, not a hard CPU interrupt
# RAG_CANDIDATES=24
# RAG_RERANK_CANDIDATES=12
# RAG_MIN_SIMILARITY=0.25
# Pin revisions for reproducible embeddings and reranking; changes reindex content.
# RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# RAG_EMBEDDING_REVISION=
# RAG_EMBEDDING_DIMENSIONS=384
# RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# RAG_RERANKER_REVISION=
#
# Remote worker (recommended over local Torch on a 1 GiB API VM):
# RAG_ALLOW_EXTERNAL=false
# RAG_WORKER_URL=https://<your-inference-worker>
# RAG_WORKER_KEY=              # same backend-only shared secret on API + worker
# RAG_TIMEOUT_SECONDS=15
#
# Local/worker models: optional requirements-rag-local.txt, sufficient RAM required.
# RAG_ALLOW_MODEL_DOWNLOAD=false  # false requires already cached model weights

# Global AskFred: relative dates use this timezone, not the browser's timezone.
# WORKSPACE_TIMEZONE=UTC       # e.g. Asia/Kolkata
# GLOBAL_CHAT_TIMEOUT_SECONDS=60
# GLOBAL_CONTEXT_CHARS=20000
# GLOBAL_CATALOG_LIMIT=80
# GLOBAL_MEETING_LIMIT=4
# GLOBAL_TASK_LIMIT=50         # displayed list cap; SQL counts cover all matches
