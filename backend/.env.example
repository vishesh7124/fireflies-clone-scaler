# --- Fireflies clone backend config (see docs/04-TECH-STACK-AND-LIBRARIES.md §5) ---

# SQLite database file (relative to backend/)
# FIREFLIES_DB_PATH=data/fireflies.db

# Generated + uploaded media directory
# MEDIA_DIR=data/media

# Auto-seed the database on startup when empty (keeps hosted demo alive)
# SEED_ON_START=true

# Comma-separated allowed origins for the frontend
# CORS_ORIGINS=http://localhost:3000

# Optional LLM (any OpenAI-compatible endpoint). When set, summaries and
# AskFred use it; when absent, rule-based engines are used.
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
